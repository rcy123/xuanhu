# 悬壶 WebUI 环境变量样例（P8-1）
# 复制为 .env.local 后按需修改。不要提交真实配置。

# API base URL。
# - 开发期默认走 Vite dev proxy（同源 /api/v1 -> http://127.0.0.1:8000），
#   可不设置此项。
# - 若前端直连后端（不走 proxy），设为 http://127.0.0.1:8000/api/v1。
# - 生产由 Nginx 同源反代，设为 /api/v1。
# VITE_API_BASE_URL=/api/v1

# 开发期 Vite proxy 转发目标。默认 http://127.0.0.1:8000。
# 后端若监听其他地址（如 docker host），在此修改。
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
