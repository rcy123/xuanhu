# ============================================================================
# 悬壶（Xuanhu）环境变量配置
# ============================================================================
# 使用方式：cp .env.example .env 后按实际环境修改
#
# 生产配置统一使用 MODEL_GATEWAY_* 口径。
# 所有示例值均为占位符，不包含真实密钥。
#
# Docker Compose 中间件默认值说明：
#   PostgreSQL:  用户 xuanhu / 密码 xuanhu_dev / 数据库 xuanhu / 端口 5432
#   Redis:       密码 xuanhu_dev / 端口 6379
#   Milvus:      端口 19530 / metrics 9091
#   MinIO:       端口 9000(API) / 9001(Console)
#   etcd:        仅容器内部通信
# ============================================================================

# ---- 应用运行配置 ----
APP_ENV=local
APP_NAME=xuanhu
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000

# ---- 数据库 ----
# PostgreSQL — 与 docker-compose.yml 默认值一致
DB_URL=postgresql://xuanhu:xuanhu_dev@localhost:5432/xuanhu
# Redis — 与 docker-compose.yml 默认值一致
REDIS_URL=redis://:xuanhu_dev@localhost:6379/0

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
# MILVUS_COLLECTION=xuanhu_knowledge_v3   # 可选，默认 xuanhu_knowledge_v3
# MILVUS_TIMEOUT_SECONDS=30               # 可选，默认 30

# ---- 模型网关（生产统一口径） ----
MODEL_GATEWAY_BASE_URL=http://localhost:8080/v1
MODEL_GATEWAY_API_KEY=sk-change-me-to-a-real-key
MODEL_GATEWAY_TIMEOUT_SECONDS=60
# GATEWAY_HEALTH_CHECK_TIMEOUT_SECONDS=10  # 可选，默认 10
MODEL_GATEWAY_MAX_RETRIES=2
MODEL_GATEWAY_ROUTE_PROFILE=default

# ---- 模型名称 ----
CHAT_MODEL=change-me-chat-model
EMBEDDING_MODEL=change-me-embedding-model
EMBEDDING_DIM=4096

# ---- Embedding 网关覆盖（本地联调用，非生产配置） ----
# 设置后将覆盖 MODEL_GATEWAY_BASE_URL / MODEL_GATEWAY_API_KEY 用于 embedding 调用
# 未设置时回退到 MODEL_GATEWAY_* 生产口径
# EMBEDDING_GATEWAY_BASE_URL=http://localhost:8080/v1
# EMBEDDING_GATEWAY_API_KEY=sk-change-me

# ---- Reranker 网关覆盖（Cross-Encoder 模式，可选） ----
# 设置后将覆盖 MODEL_GATEWAY_BASE_URL / MODEL_GATEWAY_API_KEY 用于 reranker 调用
# 未设置时回退到 MODEL_GATEWAY_* 生产口径
# RERANKER_GATEWAY_BASE_URL=http://localhost:8080/v1
# RERANKER_GATEWAY_API_KEY=sk-change-me

# ---- Reranker 模型与参数 ----
# RAG_RERANKER_ENABLED=false            # 启用 Cross-Encoder / LLM Reranker（默认关闭，模型部署后开启）
# RAG_RERANKER_MODEL=jina-reranker-m0   # Reranker 模型名称（cross_encoder 模式用专用模型，llm 模式用 LLM 名）
# RAG_RERANKER_PROVIDER=cross_encoder   # cross_encoder（专用模型）或 llm（LLM 评判）
# RAG_RERANKER_TIMEOUT_SECONDS=5.0      # Reranker 调用超时（秒），超时降级为 MVP 加权求和

# ---- P2: 辨证 Query LLM 改写（默认关闭，A/B 评测后决定是否开启） ----
# RAG_QUERY_REWRITE_ENABLED=false        # 启用 LLM 改写结构化 query 为医学叙事
# RAG_QUERY_REWRITE_MODEL=              # 改写专用模型，为空时复用 CHAT_MODEL（推荐轻量模型控制延迟）

# ---- RAG 参数 ----
# RAG_TOP_K_VECTOR=12          # 可选，默认 12
# RAG_TOP_K_FULLTEXT=12        # 可选，默认 12
# RAG_TOP_N_FINAL=8            # 可选，默认 8

# ---- Agent ----
# AGENT_RUNTIME_VERSION=legacy  # 新会话默认：legacy|langgraph；切换前必须写 runtime.switched 审计
# AGENT_RUNTIME_ROLLOUT_PHASE=legacy  # legacy|development|automated_test|internal|canary|full|rollback
# XUANHU_LANGGRAPH_PUBLIC_ENABLED=false  # 公共 API 是否允许创建 LangGraph 会话
# XUANHU_LANGGRAPH_PRODUCT_READY=false  # L5-PROD～L8-PROD/发布门禁明确完成后方可设 true
# AGENT_MAX_RETRIES=2           # 可选，默认 2
# SAFETY_ROLLBACK_LIMIT=3       # 可选，默认 3
# ENABLE_STREAMING=false        # 可选，默认 false
# PROMPT_MANIFEST_PATH=app/agents/prompts/manifest.yaml  # 可选

# ---- Durable Outbox Publisher ----
# OUTBOX_PUBLISHER_ENABLED=true
# OUTBOX_PUBLISHER_BATCH_SIZE=50
# OUTBOX_PUBLISHER_LEASE_SECONDS=30
# OUTBOX_PUBLISHER_MAX_ATTEMPTS=8
# OUTBOX_PUBLISHER_BASE_RETRY_SECONDS=1
# OUTBOX_PUBLISHER_MAX_RETRY_SECONDS=300
# OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=0.5
# OUTBOX_PUBLISHER_SHUTDOWN_GRACE_SECONDS=10
# The following readiness thresholds are exported by /api/v1/metrics/outbox
# and consumed directly by deploy/prometheus/rules/xuanhu-outbox-alerts.yml.
# OUTBOX_READY_MAX_OLDEST_AGE_SECONDS=300
# OUTBOX_READY_MAX_DEAD_LETTERS=0
# EVENT_DEDUPE_TTL_SECONDS=86400  # 可选；滑动 TTL，范围 60 秒～30 天

# ---- 会话锁与导出 ----
# SESSION_LOCK_TTL_SECONDS=90   # 可选，默认 90
# SESSION_LOCK_WAIT_SECONDS=0   # 可选，默认 0
# EXPORT_FILE_TTL_SECONDS=3600  # 可选，默认 3600

# ============================================================================
# 以下为 Docker Compose 中间件内部变量，一般无需修改
# ============================================================================

# ---- PostgreSQL 容器变量 ----
# POSTGRES_USER=xuanhu          # 默认 xuanhu
# POSTGRES_PASSWORD=xuanhu_dev  # 默认 xuanhu_dev
# POSTGRES_DB=xuanhu            # 默认 xuanhu
# POSTGRES_PORT=5432            # 默认 5432

# ---- Redis 容器变量 ----
# REDIS_PASSWORD=xuanhu_dev     # 默认 xuanhu_dev
# REDIS_PORT=6379               # 默认 6379

# ---- MinIO 容器变量 ----
# MINIO_ACCESS_KEY=minioadmin   # 默认 minioadmin
# MINIO_SECRET_KEY=minioadmin   # 默认 minioadmin
# MINIO_API_PORT=9000           # 默认 9000
# MINIO_CONSOLE_PORT=9001       # 默认 9001

# ---- Milvus 容器变量 ----
# MILVUS_METRICS_PORT=9091      # 默认 9091
