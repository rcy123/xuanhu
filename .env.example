# ============================================================================
# 悬壶（Xuanhu）环境变量配置 — 模板（覆盖 Settings 全部 100 个字段）
# ============================================================================
# 使用方式：cp .env.example .env 后按实际环境修改
# 标注「必填」的字段缺失会导致启动失败；其余字段可留默认值。
# 生产配置统一使用 MODEL_GATEWAY_* 口径。
# 所有示例值均为占位符，不包含真实密钥；网关地址/模型名请按实际环境替换。
# Docker Compose 中间件默认值：PostgreSQL(xuanhu/xuanhu_dev/xuanhu:5432)、
#   Redis(:xuanhu_dev@6379)、Milvus(19530/metrics 9091)、MinIO(9000/9001)。
# ============================================================================

# ---- 应用运行 ----
APP_ENV=local  # 运行环境: local / staging / production；默认 local
APP_NAME=xuanhu  # 应用名称；默认 xuanhu
APP_VERSION=0.1.0  # 应用版本号；默认 0.1.0
API_HOST=127.0.0.1  # API 监听地址；默认 127.0.0.1（生产经反向代理终止 TLS；0.0.0.0 仅开发用）
API_PORT=8000  # API 监听端口；默认 8000
API_WORKERS=1  # uvicorn worker 进程数（阶段2 横向扩展）；1=单进程，>1=多进程（命令 worker/outbox 靠 SKIP LOCKED 安全并行，会话锁靠 PG advisory lock）

# ---- 数据库 / 缓存 / 向量库 ----
DB_URL=postgresql://xuanhu:xuanhu_dev@localhost:5432/xuanhu  # PostgreSQL 连接串；必填
DB_POOL_SIZE=10  # SQLAlchemy 连接池大小（每进程）；多 worker 时保证 workers×(size+overflow) ≤ PG max_connections
DB_POOL_MAX_OVERFLOW=20  # 连接池溢出上限（每进程）
REDIS_URL=redis://:xuanhu_dev@localhost:6379/0  # Redis 连接串；必填
MILVUS_HOST=localhost  # Milvus 服务地址；默认 localhost
MILVUS_PORT=19530  # Milvus 端口；默认 19530
MILVUS_COLLECTION=xuanhu_knowledge_v4  # Milvus collection（v4=含 content 字段 M1 直返）；默认 xuanhu_knowledge_v4
MILVUS_TIMEOUT_SECONDS=30  # Milvus 连接超时（秒）；默认 30

# ---- 模型网关（生产统一口径） ----
MODEL_GATEWAY_BASE_URL=http://localhost:8080/v1  # 模型网关地址（生产/内网网关）；必填
MODEL_GATEWAY_API_KEY=sk-change-me-to-a-real-key  # 模型网关 API 密钥（日志脱敏，勿外泄）；必填
MODEL_GATEWAY_TIMEOUT_SECONDS=90  # 网关请求超时（秒）；默认 60
GATEWAY_HEALTH_CHECK_TIMEOUT_SECONDS=10  # 网关健康检查超时（秒）；默认 10
MODEL_GATEWAY_MAX_RETRIES=2  # 网关请求最大重试次数；默认 2
MODEL_GATEWAY_CIRCUIT_BREAKER_THRESHOLD=5  # 阶段4 熔断：连续失败达到该阈值后打开熔断器快速失败；默认 5
MODEL_GATEWAY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30  # 阶段4 熔断：打开后的冷却时长（秒），冷却后进入半开探测；默认 30
MODEL_GATEWAY_ROUTE_PROFILE=default  # 网关路由 profile；默认 default
REASONING_RETRY_BACKOFF_BASE_SECONDS=10.0  # reasoning 节点级重试指数退避基数（秒），0=关闭（测试用）；默认 10.0
MODEL_GATEWAY_STRUCTURED_MODE=auto  # 结构化输出模式: tools / json_object / auto；默认 auto

# ---- Embedding 网关 ----
EMBEDDING_GATEWAY_BASE_URL=http://localhost:8080/v1  # Embedding 专用网关地址，空=回退 MODEL_GATEWAY_BASE_URL
EMBEDDING_GATEWAY_API_KEY=sk-change-me  # Embedding 专用网关密钥，空=回退 MODEL_GATEWAY_API_KEY
EMBEDDING_GATEWAY_TIMEOUT_SECONDS=0  # Embedding 网关超时（秒），0=回退 MODEL_GATEWAY_TIMEOUT_SECONDS；默认 0
EMBEDDING_GATEWAY_MAX_RETRIES=0  # Embedding 网关最大重试次数，0=回退 MODEL_GATEWAY_MAX_RETRIES；默认 0
EMBEDDING_CACHE_TTL_SECONDS=3600  # Embedding 向量缓存 TTL（秒），0=不缓存；默认 3600
EMBEDDING_CACHE_PREWARM_ON_STARTUP=false  # 启动时后台预热 embedding 缓存（不阻塞就绪）；默认 false

# ---- Reranker 网关 ----
RERANKER_GATEWAY_BASE_URL=http://localhost:8080/v1  # Reranker 专用网关地址，空=回退 MODEL_GATEWAY_BASE_URL
RERANKER_GATEWAY_API_KEY=sk-change-me  # Reranker 专用网关密钥，空=回退 MODEL_GATEWAY_API_KEY
RERANKER_GATEWAY_TIMEOUT_SECONDS=0  # Reranker 网关超时（秒），0=回退 MODEL_GATEWAY_TIMEOUT_SECONDS；默认 0
RERANKER_GATEWAY_MAX_RETRIES=0  # Reranker 网关最大重试次数，0=回退 MODEL_GATEWAY_MAX_RETRIES；默认 0

# ---- 模型名称 ----
CHAT_MODEL=change-me-chat-model  # 对话模型名称（必填）；必填
EMBEDDING_MODEL=change-me-embedding-model  # Embedding 模型名称（必填）；必填
EMBEDDING_DIM=4096  # 向量维度，必须与 Milvus collection 一致（必填）；必填

# ---- RAG 检索 ----
XUANHU_RAG_ENABLED=true  # 推理链路 RAG 总开关；关闭时走 no-rag 契约；默认 true
RAG_SYNDROME_ENABLED=true  # 辨证阶段 RAG 开关（需 rag_enabled=true 才生效）；默认 true
RAG_FORMULA_ENABLED=true  # 开方阶段 RAG 开关（需 rag_enabled=true 才生效）；默认 true
RAG_TOP_K_VECTOR=12  # 向量检索 top-k；默认 12
RAG_TOP_K_FULLTEXT=12  # 全文检索 top-k；默认 12
RAG_FULLTEXT_LEXICAL_ENABLED=true  # 中文 Query 拆短词全文候选召回（关闭=整句 FTS/ILIKE）；默认 true
RAG_FULLTEXT_LEXICAL_MAX_TERMS=12  # 中文全文候选召回最多使用的短词数量；默认 12
RAG_DUAL_QUERY_ENABLED=false  # 是否对辨证 Query 与改写 Query 做候选级 RRF 融合；默认 false
RAG_DUAL_QUERY_RRF_K=60  # 双视图候选融合的 Reciprocal Rank Fusion 常数；默认 60
RAG_SYNDROME_TOP_K=8  # 辨证检索最终返回条数；默认 8
RAG_FORMULA_TOP_K=8  # 开方检索最终返回条数；默认 8
RAG_TOP_N_FINAL=8  # 合并去重后最终返回条数；默认 8
RAG_QUERY_MAX_CHARS=600  # 推理检索 query 最大长度；默认 600

# ---- 基础方 ----
BASE_FORMULA_CONFIDENCE_THRESHOLD=0.45  # 基础方候选方案的置信度阈值——低于此值的方案被丢弃，不进入 modification；默认 0.45
BASE_FORMULA_MIN_ALTERNATIVES=1  # 至少保留的基础方候选数（即使低于阈值也保留 top-N）；默认 1
BASE_FORMULA_MAX_ALTERNATIVES=3  # 最多保留的基础方候选数；默认 3

# ---- 辨证 Query 改写 ----
RAG_QUERY_REWRITE_ENABLED=true  # 是否启用辨证 query LLM 改写；默认 false
RAG_QUERY_REWRITE_MODEL=qwen3-8b  # 改写专用模型，空=复用 chat_model
RAG_QUERY_REWRITE_MODEL_TEMPERATURE=0.1  # 改写模型 temperature（低温度保证输出稳定、可复现）；默认 0.1
RAG_QUERY_REWRITE_MODEL_MAX_TOKENS=400  # 改写模型最大输出 token 数；默认 400
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=3.0  # 改写调用超时秒数（超时降级为原始 query）；默认 3.0
RAG_QUERY_REWRITE_GATEWAY_BASE_URL=http://localhost:8080/v1  # 改写专用网关地址，空=回退主网关
RAG_QUERY_REWRITE_GATEWAY_API_KEY=sk-change-me  # 改写专用网关密钥，空=回退主网关
RAG_QUERY_REWRITE_GATEWAY_TIMEOUT_SECONDS=0  # 改写网关超时（秒），0=回退 rag_query_rewrite_timeout_seconds；默认 0
RAG_QUERY_REWRITE_GATEWAY_MAX_RETRIES=0  # 改写网关最大重试次数，0=回退 model_gateway_max_retries；默认 0

# ---- Reranker 参数 ----
RAG_RERANKER_ENABLED=true  # 是否启用 Cross-Encoder / LLM Reranker（默认关闭，关闭时使用 MVP 加权求和）；默认 false
RAG_RERANKER_PROVIDER=cross_encoder  # Reranker 类型：cross_encoder（专用模型）或 llm（LLM 评判）；默认 cross_encoder
RAG_RERANKER_MODEL=jina-reranker-m0  # Reranker 模型名（cross_encoder / llm 模式）
RAG_RERANKER_TOP_K=20  # 送入 reranker 的候选 chunk 数量（从 ANN 召回中取 top-K）；默认 20
RAG_RERANKER_FULLTEXT_QUOTA=0  # 候选池保留的全文独有候选数，0=保持原顺序；默认 0
RAG_RERANKER_MAX_CHUNKS_PER_SOURCE=0  # 候选池同源最多 chunk 数，0=不多样化；默认 0
RAG_RERANKER_FINAL_TOP_K=8  # Reranker 重排后最终返回的 chunk 数量；默认 8
RAG_RERANKER_TIMEOUT_SECONDS=5.0  # Reranker 调用超时秒数（超时降级为 MVP 加权求和）；默认 5.0

# ---- Agent 运行时与开关 ----
AGENT_RUNTIME_VERSION=langgraph  # 新会话默认运行时: legacy|langgraph（不改变既有会话）；默认 legacy
AGENT_RUNTIME_ROLLOUT_PHASE=development  # L9 新会话切流阶段（full/rollback 启用失败封闭）；默认 legacy
XUANHU_LANGGRAPH_PUBLIC_ENABLED=true  # 公共 API 允许新建 LangGraph 会话；默认 false
XUANHU_LANGGRAPH_PRODUCT_READY=false  # L5-PROD～L8-PROD 发布门禁完成授权，完成后置 true；默认 false
XUANHU_INTAKE_SLOT_PATH_ENABLED=true  # 新会话走槽位采集范式（阶段2灰度）；默认 false
XUANHU_QUESTION_CONTRACT_ENABLED=true  # R9 问题契约编排开关（默认关=现网行为不变）；默认 false
XUANHU_QUESTION_CONTRACT_MAX_FOLLOWUPS=2  # R9 根契约残余追问次数上限（revision 上限=该值+1）；默认 2
AGENT_MAX_RETRIES=2  # Agent 最大重试次数；默认 2
SAFETY_ROLLBACK_LIMIT=3  # 安全审核回退次数上限；默认 3
ENABLE_STREAMING=false  # 是否启用 SSE 流式输出；默认 false
SSE_HEARTBEAT_INTERVAL_SECONDS=30.0  # SSE 空闲心跳间隔（秒）；默认 30.0
PROMPT_MANIFEST_PATH=app/agents/prompts/manifest.yaml  # Prompt 清单文件路径；默认 app/agents/prompts/manifest.yaml

# ---- Durable Outbox 发布器 ----
OUTBOX_PUBLISHER_ENABLED=true  # 启动 PostgreSQL Outbox 到 Redis Stream 的后台发布器；默认 true
OUTBOX_PUBLISHER_BATCH_SIZE=50  # 发布器每批处理的消息条数；默认 50
OUTBOX_PUBLISHER_LEASE_SECONDS=30  # 发布器租约秒数（防并发重复处理）；默认 30
OUTBOX_PUBLISHER_MAX_ATTEMPTS=8  # 单条消息最大投递尝试次数（超出进死信）；默认 8
OUTBOX_PUBLISHER_BASE_RETRY_SECONDS=1  # 投递重试退避基数（秒）；默认 1
OUTBOX_PUBLISHER_MAX_RETRY_SECONDS=300  # 投递重试退避上限（秒）；默认 300
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=0.5  # Outbox 轮询间隔（秒）；默认 0.5
OUTBOX_PUBLISHER_SHUTDOWN_GRACE_SECONDS=10  # 发布器优雅停机宽限（秒）；默认 10
OUTBOX_READY_MAX_OLDEST_AGE_SECONDS=300  # 就绪阈值：最老未消费消息年龄（秒），供 /api/v1/metrics/outbox 消费；默认 300
OUTBOX_READY_MAX_DEAD_LETTERS=0  # 就绪阈值：允许的最大死信数；默认 0
EVENT_DEDUPE_TTL_SECONDS=86400  # Redis Stream 每会话 Outbox 去重窗口滑动 TTL（秒）；默认 86400

# ---- 异步命令 Worker ----
XUANHU_ASYNC_COMMAND_ENABLED=true  # 后台 AsyncCommandWorker（false=回滚/熔断回同步路径）；默认 true
XUANHU_GRAPH_RUNNER_TIMEOUT_SECONDS=300  # LangGraph 单次执行总超时（秒）；必须 > 2×(网关超时+15) 才够辨证+开方最坏时长；默认 300
ASYNC_COMMAND_BATCH_SIZE=10  # Worker 每批处理的命令条数；默认 10
ASYNC_COMMAND_MAX_CONCURRENCY=8  # 阶段1 并发消费：一批命令中跨会话并行上限（同会话仍串行）；默认 8
ASYNC_COMMAND_MAX_QUEUE_DEPTH=200  # 阶段4 背压：未终结命令数达到该阈值时 admission 返回 503；0=禁用；默认 200
ASYNC_COMMAND_LEASE_SECONDS=60  # 命令租约秒数（防并发重复执行）；默认 60
ASYNC_COMMAND_HEARTBEAT_SECONDS=20  # Worker 心跳间隔（必须 < lease）；默认 20
ASYNC_COMMAND_MAX_ATTEMPTS=8  # 命令最大执行尝试次数；默认 8
ASYNC_COMMAND_RETRY_BASE_SECONDS=1  # 命令重试退避基数（秒）；默认 1
ASYNC_COMMAND_RETRY_MAX_SECONDS=300  # 命令重试退避上限（秒）；默认 300
ASYNC_COMMAND_POLL_INTERVAL_SECONDS=0.5  # 命令轮询间隔（秒）；默认 0.5
ASYNC_COMMAND_SHUTDOWN_GRACE_SECONDS=10  # Worker 优雅停机宽限（秒）；默认 10

# ---- 会话锁与导出 ----
SESSION_LOCK_TTL_SECONDS=90  # 会话锁 TTL（秒）；默认 90
SESSION_LOCK_WAIT_SECONDS=0  # 会话锁等待超时（秒），0 表示不等待；默认 0
EXPORT_FILE_TTL_SECONDS=3600  # 导出文件 TTL（秒）；默认 3600

# ---- 生产环境加固：认证授权（阶段 1） ----
JWT_SIGNING_KEY=change-me-48-bytes-random  # JWT 签名密钥（HS256，生产必填且须为强随机；缺失/占位符 fail-fast）
JWT_SIGNING_KEY_PREVIOUS=  # 双密钥灰度期的旧签名密钥（可选；轮换完成后移除）
JWT_ACCESS_TOKEN_TTL_SECONDS=28800  # token 有效期（秒）；默认 8 小时
XUANHU_AUTH_ENABLED=on  # 阶段1 认证三态开关：off/audit/on；生产稳定后必须为 on
LOGIN_FAIL_LOCK_THRESHOLD=5  # 连续登录失败锁定阈值；默认 5
LOGIN_FAIL_LOCK_SECONDS=900  # 登录失败锁定时长（秒）；默认 15 分钟

# ---- 生产环境加固：PHI 访问控制（阶段 2） ----
XUANHU_ACCESS_ENABLED=on  # 阶段2 会话所有权校验三态开关：off/audit/on；生产稳定后必须为 on

# ---- 生产环境加固：基础设施（阶段 3） ----
XUANHU_PROD_SECRET_GUARD=true  # 生产密钥占位符 fail-fast 守卫；紧急时可关但需事后审计
MILVUS_USE_TLS=false  # Milvus 使用 TLS（内网明文可接受，跨机部署再开启）；默认 false

# ---- 生产环境加固：运行态安全（阶段 4） ----
XUANHU_RATELIMIT_ENABLED=true  # 阶段4 限流总开关；紧急时可关但需事后审计
LOGIN_RATE_LIMIT_PER_MINUTE=10  # 登录接口按 IP 限流（次/分钟）；默认 10
ADVANCE_RATE_LIMIT_PER_MINUTE=20  # advance 接口按医师限流（次/分钟）；默认 20
WRITE_RATE_LIMIT_PER_MINUTE=60  # 其余写接口按医师限流（次/分钟）；默认 60
STREAM_CONCURRENT_LIMIT=5  # SSE 按医师并发连接上限；默认 5
CORS_ALLOWED_ORIGINS=http://localhost:5173  # CORS 允许来源（逗号分隔）；生产禁止通配符 *
MODEL_WHITELIST=  # 允许的模型名白名单（逗号分隔）；生产为空即 fail-fast

# ============================================================================
# 以下为 Docker Compose 中间件内部变量（非 Settings 字段）
# ============================================================================
# 生产部署（阶段 3）：中间件端口不映射 host，凭据强必填无默认值。用
#   ./scripts/gen-secrets.sh 生成强随机凭据后填入 .env，再
#   docker compose -f docker-compose.yml up -d
# 本地开发：docker compose up -d 自动加载 docker-compose.override.yml，
#   使用下方默认凭据并加回端口映射。
# POSTGRES_USER=xuanhu / POSTGRES_PASSWORD= / POSTGRES_DB=xuanhu / POSTGRES_PORT=5432
# REDIS_PASSWORD= / REDIS_PORT=6379
# MINIO_ACCESS_KEY= / MINIO_SECRET_KEY= / MINIO_API_PORT=9000 / MINIO_CONSOLE_PORT=9001
# MILVUS_METRICS_PORT=9091
